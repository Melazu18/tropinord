{
  "name": "tropinord-site",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://your-username.github.io/your-repo-name",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "generate:posts": "node scripts/generateBlogContent.js",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "predev": "npm run generate:sitemap",
    "dev": "npm run generate:posts && vite",
    "prebuild": "npm run generate:sitemap",
    "build": "npm run generate:posts && vite build",
    "preview": "vite preview",
    "deploy": "npm run generate:sitemap && vite build && gh-pages -d dist",
    "update:rates": "node scripts/updateRates.js",
    "clean-install": "rm -rf node_modules && rm -f package-lock.json && npm install"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@mdx-js/react": "^3.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@tailwindcss/typography": "^0.5.16",
    "@use-gesture/react": "^10.3.1",
    "axios": "^1.9.0",
    "framer-motion": "^12.23.0",
    "fs-extra": "^11.3.0",
    "gray-matter": "^4.0.3",
    "history": "^5.3.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^8.2.0",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.523.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^7.0.5",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-helmet-async": "^2.0.5",
    "react-hot-toast": "^2.5.2",
    "react-i18next": "^13.5.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.22.1",
    "react-toastify": "^11.0.5",
    "remark-frontmatter": "^5.0.0",
    "slugify": "^1.6.6",
    "stripe": "^18.3.0",
    "tailwindcss-rtl": "^0.9.0",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
